<Window x:Class="ModbusDAQ.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModbusDAQ - 登录" Height="300" Width="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="工业数据采集监控系统" FontSize="16"
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"
                   Foreground="#007ACC"/>

        <!-- 用户名 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="用户名" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameBox" FontSize="14" Padding="6" Height="32"/>
        </StackPanel>

        <!-- 密码 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="密码" FontSize="13" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="6" Height="32"/>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,8,0,0">
            <Button Content="登录" Click="Login_Click" Width="90" Height="32"
                    FontSize="14" Background="#007ACC" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"/>
            <Button Content="退出" Click="Exit_Click" Width="90" Height="32"
                    FontSize="14" Background="#999" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
