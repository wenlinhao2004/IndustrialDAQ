<Window x:Class="IndustrialDAQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:vm="clr-namespace:IndustrialDAQ.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="工业设备数据采集监控系统 (Modbus TCP/RTU | OPC UA | S7)" Height="780" Width="1300"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部工具栏 ===== -->
        <Border Grid.Row="0" Padding="10" Margin="0,0,0,6"
                Background="#F0F0F0" CornerRadius="6">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="模式:" VerticalAlignment="Center" FontSize="13" Margin="0,0,6,0"/>
                <ComboBox SelectedIndex="{Binding SelectedMode}" Width="80" Height="26"
                          VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13">
                    <ComboBoxItem Content="TCP"/>
                    <ComboBoxItem Content="RTU"/>
                    <ComboBoxItem Content="OPC UA"/>
                    <ComboBoxItem Content="S7"/>
                </ComboBox>

                <!-- TCP 配置 -->
                <TextBlock Text="IP:" VerticalAlignment="Center" FontSize="13" Margin="0,0,6,0"/>
                <TextBox Text="{Binding IpAddress}" Width="110" VerticalAlignment="Center"
                         Margin="0,0,12,0" FontSize="13" Padding="4"/>

                <!-- RTU 串口配置 -->
                <TextBlock Text="串口:" VerticalAlignment="Center" FontSize="13" Margin="0,0,6,0"/>
                <TextBox Text="{Binding ComPort}" Width="70" VerticalAlignment="Center"
                         Margin="0,0,6,0" FontSize="13" Padding="4"/>
                <TextBlock Text="波特率:" VerticalAlignment="Center" FontSize="13" Margin="0,0,6,0"/>
                <ComboBox SelectedItem="{Binding BaudRate}" Width="80" Height="26"
                          VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13">
                    <sys:Int32>9600</sys:Int32>
                    <sys:Int32>19200</sys:Int32>
                    <sys:Int32>38400</sys:Int32>
                    <sys:Int32>115200</sys:Int32>
                </ComboBox>

                <!-- OPC UA 配置 -->
                <TextBlock Text="端点:" VerticalAlignment="Center" FontSize="13" Margin="0,0,6,0"/>
                <TextBox Text="{Binding OpcUaEndpointUrl}" Width="200" VerticalAlignment="Center"
                         Margin="0,0,12,0" FontSize="13" Padding="4"/>


                <TextBlock Text="间隔(ms):" VerticalAlignment="Center" FontSize="13" Margin="0,0,4,0"/>
                <TextBox Text="{Binding LogIntervalText}" Width="60" VerticalAlignment="Center"
                         Margin="0,0,12,0" FontSize="13" Padding="4"/>

                <Button Content="{Binding ConnectBtnText}" Command="{Binding ConnectCommand}"
                        Width="90" Height="30" Margin="0,0,6,0"
                        FontSize="13" Background="#007ACC" Foreground="White" BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>

                <Button Content="模拟模式" Command="{Binding SimulationCommand}"
                        Width="80" Height="30" Margin="0,0,12,0"
                        FontSize="13" Background="#5CB85C" Foreground="White" BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>

                <Border Width="2" Background="#CCC" Margin="4,2,16,2"/>

                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold">
                    <Run Text="状态: "/>
                    <Run Text="{Binding StatusText}" Foreground="{Binding IsConnected,
                         Converter={StaticResource BoolToColorConverter}}"/>
                </TextBlock>

                <Border Width="2" Background="#CCC" Margin="16,2,16,2"/>

                <TextBlock VerticalAlignment="Center" FontSize="13">
                    <Run Text="管道: "/>
                    <Run Text="{Binding PipelineStatus}" Foreground="#007ACC"/>
                </TextBlock>
            </WrapPanel>
        </Border>

        <!-- ===== 主体三栏 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：实时数据表 -->
            <Border Grid.Column="0" Margin="0,0,3,0" Padding="8"
                    Background="#FAFAFA" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="实时数据" FontSize="15" FontWeight="Bold"
                               Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding Tags}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="0,0,0,2" CornerRadius="4"
                                        Background="{Binding IsAlarm, Converter={StaticResource BoolToAlarmBgConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <TextBlock FontSize="12" Foreground="Gray">
                                                <Run Text="{Binding Value, StringFormat={}{0:F2}}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Unit}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   Text="{Binding AlarmType}" FontSize="12"
                                                   Foreground="Red" FontWeight="Bold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 中间：实时趋势图 -->
            <Border Grid.Column="1" Margin="3,0" Padding="8"
                    Background="White" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1">
                <oxy:PlotView Model="{Binding PlotModel}"/>
            </Border>

            <!-- 右侧：选项卡 (报警 + 历史数据) -->
            <TabControl Grid.Column="2" Margin="3,0,0,0" FontSize="13">
                <!-- ====== 报警 Tab ====== -->
                <TabItem Header="报警">
                    <Border Padding="8" Background="#FFF8F8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="报警 (" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding AlarmCount}" FontSize="14" FontWeight="Bold"
                                           Foreground="Red"/>
                                <TextBlock Text=")" FontSize="14" FontWeight="Bold"/>
                                <Button Content="清除" Command="{Binding ClearAlarmsCommand}"
                                        Width="50" Height="24" Margin="12,0,0,0" FontSize="12"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Alarms}" BorderThickness="0"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,3" Margin="0,0,0,2" CornerRadius="3"
                                                Background="#FFF0F0">
                                            <StackPanel>
                                                <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding TagName}"/>
                                                <TextBlock FontSize="11" Foreground="Red">
                                                    <Run Text="{Binding Type, StringFormat={}{0}:}"/>
                                                    <Run Text="{Binding Value, StringFormat={}{0:F2}}"/>
                                                    <Run Text=" (限值 "/><Run Text="{Binding Limit, StringFormat={}{0:F2}}"/><Run Text=")"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Time}" FontSize="10" Foreground="Gray"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- ====== 历史数据 Tab ====== -->
                <TabItem Header="历史数据">
                    <Border Padding="8" Background="#FAFAFF">
                        <DockPanel>
                            <!-- 查询条件 -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="点位:" VerticalAlignment="Center" FontSize="13"
                                               Margin="0,0,6,0"/>
                                    <ComboBox SelectedItem="{Binding SelectedHistoryTag}"
                                              Width="110" Height="26" FontSize="12">
                                        <ComboBoxItem Content="全部"/>
                                        <ComboBoxItem Content="主电机温度"/>
                                        <ComboBoxItem Content="冷却水温度"/>
                                        <ComboBoxItem Content="管道压力"/>
                                        <ComboBoxItem Content="电机转速"/>
                                        <ComboBoxItem Content="流量"/>
                                        <ComboBoxItem Content="液位"/>
                                        <ComboBoxItem Content="阀门开度"/>
                                    </ComboBox>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="查询" Command="{Binding QueryHistoryCommand}"
                                            Width="60" Height="26" FontSize="12"
                                            Background="#007ACC" Foreground="White" BorderThickness="0"
                                            Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="导出CSV" Command="{Binding ExportCsvCommand}"
                                            Width="70" Height="26" FontSize="12"
                                            Background="#5CB85C" Foreground="White" BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style>
                                        </Button.Resources>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="Gray">
                                    <Run Text="共 "/><Run Text="{Binding HistoryRecordCount}"/><Run Text=" 条"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- 查询结果 -->
                            <ListBox ItemsSource="{Binding HistoryRecords}" BorderThickness="0"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="3,2" Margin="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TagName}" FontSize="11"
                                                           FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayValue}"
                                                           FontSize="11" Foreground="#007ACC"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Timestamp}"
                                                           FontSize="10" Foreground="Gray"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ===== 底部：线程日志 + 串口调试 ===== -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 多线程日志 -->
            <Border Grid.Column="0" Margin="0,0,4,0" Padding="8"
                    Background="#1E1E1E" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="多线程日志 (Producer / Consumer)"
                               FontSize="13" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding Logs}" BorderThickness="0"
                             Background="Transparent" Foreground="#D4D4D4"
                             FontFamily="Consolas" FontSize="11">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding .}" Foreground="#D4D4D4"
                                           FontFamily="Consolas" FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 串口调试面板 -->
            <Border Grid.Column="1" Margin="4,0,0,0" Padding="8"
                    Background="#F8F8F8" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="串口调试工具" FontSize="13"
                               FontWeight="Bold" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="打开串口" Command="{Binding OpenSerialCommand}"
                                Width="70" Height="26" FontSize="12" Margin="0,0,6,0"/>
                        <Button Content="发送测试" Command="{Binding SendSerialCommand}"
                                Width="70" Height="26" FontSize="12" Margin="0,0,6,0"/>
                        <Button Content="刷新" Command="{Binding RefreshPortsCommand}"
                                Width="50" Height="26" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SerialStatus}" FontSize="11"
                               Foreground="Gray" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 底部状态栏 ===== -->
        <StatusBar Grid.Row="3" Margin="0,4,0,0" FontSize="11">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Modbus TCP/RTU  |  多线程管道(Producer-Consumer)  |  "/>
                    <Run Text="{Binding DbStatus}" Foreground="#007ACC"/>
                    <Run Text="  |  采集计数: "/>
                    <Run Text="{Binding LogCount}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
